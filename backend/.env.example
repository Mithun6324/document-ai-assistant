# App
APP_NAME=Document AI Assistant
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://docai:docai@localhost:5432/docai

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Gemini (required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER=gemini

# Optional DeepSeek fallback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=document_chunks

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# RAG
TOP_K=5
RETRIEVAL_CANDIDATES=20
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_TOKENS=6000
MAX_CHUNK_SIZE=1200
CHUNK_OVERLAP=80